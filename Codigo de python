import time
import cv2
import numpy as np
import serial
import serial.tools.list_ports

CAMARA_INDICE = 1
PUERTO_SERIAL = "COM3"
BAUDIOS = 115200

FIGURA_OSCURA_FONDO_CLARO = True

MARGEN_ROI_X = 0.15
MARGEN_ROI_Y = 0.10

AREA_MIN = 2200
AREA_MAX = 120000
EPSILON = 0.032

SOLIDEZ_MIN = 0.84
CUADRADO_EXTENT_MIN = 0.78
CUADRADO_ASPECTO_MIN = 0.75

TRIANGULO_EXTENT_MAX = 0.68
TRIANGULO_AREA_REL_MIN = 0.55

CIRCULO_CIRCULARIDAD_MIN = 0.76
CIRCULO_ASPECTO_MIN = 0.76

FRAMES_ESTABLES = 4
FRAMES_SIN_FIGURA = 6
TIMEOUT_SEGURIDAD_S = 6.5

DESTINO = {"Cuadrado": "L", "Triangulo": "R", "Circulo": "C"}
NOMBRE_DESTINO = {"L": "IZQUIERDA (30°)", "C": "CENTRO (90°)", "R": "DERECHA (150°)"}
COLORES = {
    "Circulo": (0, 220, 0),
    "Cuadrado": (255, 120, 0),
    "Triangulo": (220, 0, 220)
}


def segmentar_imagen(roi_frame):
    gris = cv2.cvtColor(roi_frame, cv2.COLOR_BGR2GRAY)
    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
    contraste = clahe.apply(gris)
    suave = cv2.GaussianBlur(contraste, (7, 7), 0)

    tipo_umbral = cv2.THRESH_BINARY_INV if FIGURA_OSCURA_FONDO_CLARO else cv2.THRESH_BINARY
    _, umbral = cv2.threshold(suave, 0, 255, tipo_umbral + cv2.THRESH_OTSU)

    k5 = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))
    k9 = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (9, 9))

    limpia = cv2.morphologyEx(umbral, cv2.MORPH_OPEN, k5, iterations=2)
    segmentada = cv2.morphologyEx(limpia, cv2.MORPH_CLOSE, k9, iterations=2)

    return segmentada, umbral


def clasificar_forma(cnt):
    hull = cv2.convexHull(cnt)
    area = cv2.contourArea(cnt)
    area_hull = cv2.contourArea(hull)
    perimetro = cv2.arcLength(cnt, True)

    if area < AREA_MIN or area > AREA_MAX or perimetro == 0 or area_hull == 0:
        return None, ""

    solidez = area / area_hull
    if solidez < SOLIDEZ_MIN:
        return None, ""

    aprox = cv2.approxPolyDP(cnt, EPSILON * perimetro, True)
    vertices = len(aprox)

    (_, _), (w, h), _ = cv2.minAreaRect(cnt)
    if w == 0 or h == 0:
        return None, ""

    aspecto = min(w, h) / max(w, h)
    extent_rect = area / (w * h)
    circularidad = (4 * np.pi * area) / (perimetro ** 2)

    info = f"V:{vertices} S:{solidez:.2f} E:{extent_rect:.2f}"

    if vertices in (3, 4, 5) and extent_rect <= TRIANGULO_EXTENT_MAX:
        _, tri = cv2.minEnclosingTriangle(hull)
        if tri is not None:
            tri_pts = tri.reshape(-1, 2).astype(np.float32)
            area_tri = cv2.contourArea(tri_pts)
            if area_tri > 0 and (area / area_tri) >= TRIANGULO_AREA_REL_MIN:
                return "Triangulo", info

    if vertices in (4, 5) and extent_rect >= CUADRADO_EXTENT_MIN:
        if aspecto >= CUADRADO_ASPECTO_MIN and circularidad < 0.85:
            return "Cuadrado", info

    if vertices >= 6 and circularidad >= CIRCULO_CIRCULARIDAD_MIN:
        if aspecto >= CIRCULO_ASPECTO_MIN:
            return "Circulo", info

    return None, info


def conectar_esp32():
    try:
        ser = serial.Serial(PUERTO_SERIAL, BAUDIOS, timeout=0.01)
        time.sleep(2)
        ser.reset_input_buffer()
        print(f"ESP32 conectado en {PUERTO_SERIAL}")
        return ser
    except serial.SerialException as e:
        puertos = [p.device for p in serial.tools.list_ports.comports()]
        print(f"Error serial: {e}\nPuertos disponibles: {puertos}")
        print("Continuando en modo simulacion (sin ESP32).")
        return None


def enviar(ser, codigo):
    if codigo not in NOMBRE_DESTINO:
        return False

    print(f"-> Enviando {codigo}: {NOMBRE_DESTINO[codigo]}")
    if ser:
        try:
            ser.reset_input_buffer()
            ser.write(codigo.encode("ascii"))
            ser.flush()
            return True
        except (serial.SerialException, OSError) as e:
            print(f"Error serial al enviar: {e}")
            return False
    return True


def revisar_estado_esp32(ser, ocupado_actual, t_envio):
    if not ser:
        if ocupado_actual and (time.time() - t_envio >= 5.0):
            print("<- [SIMULACION] READY")
            return False
        return ocupado_actual

    try:
        while ser.in_waiting:
            linea = ser.readline().decode(errors="ignore").strip()
            if not linea:
                continue
            print(f"<- ESP32: {linea}")
            if "READY" in linea:
                return False
            elif "BUSY" in linea:
                ocupado_actual = True
    except (serial.SerialException, OSError) as e:
        print(f"Error de lectura serial: {e}")

    if ocupado_actual and (time.time() - t_envio >= TIMEOUT_SEGURIDAD_S):
        print("<- [TIMEOUT] Liberando bloqueo por seguridad.")
        return False

    return ocupado_actual


def main():
    ser = conectar_esp32()
    cap = cv2.VideoCapture(CAMARA_INDICE, cv2.CAP_DSHOW)
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
    cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)

    if not cap.isOpened():
        print(f"No se pudo abrir la camara {CAMARA_INDICE}.")
        if ser:
            ser.close()
        return

    ultima_forma = None
    estable = 0
    sin_figura = 0

    esp32_ocupado = False
    t_envio = 0.0
    ultima_accion = ""
    mostrar_filtros = False
    t_prev = time.time()

    try:
        while True:
            ok, frame = cap.read()
            if not ok:
                break

            t_actual = time.time()
            fps = 1.0 / (t_actual - t_prev) if (t_actual - t_prev) > 0 else 0
            t_prev = t_actual

            h_f, w_f = frame.shape[:2]
            rx1 = int(w_f * MARGEN_ROI_X)
            ry1 = int(h_f * MARGEN_ROI_Y)
            rx2 = int(w_f * (1.0 - MARGEN_ROI_X))
            ry2 = int(h_f * (1.0 - MARGEN_ROI_Y))
            roi = frame[ry1:ry2, rx1:rx2]

            cv2.rectangle(frame, (rx1, ry1), (rx2, ry2), (255, 255, 0), 1)

            estaba_ocupado = esp32_ocupado
            esp32_ocupado = revisar_estado_esp32(ser, esp32_ocupado, t_envio)

            if estaba_ocupado and not esp32_ocupado:
                ultima_forma = None
                estable = 0
                sin_figura = 0

            segmentada, mascara_umbral = segmentar_imagen(roi)
            contornos, _ = cv2.findContours(
                segmentada, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
            )

            figuras = []
            h_roi, w_roi = roi.shape[:2]

            for cnt in contornos:
                area = cv2.contourArea(cnt)
                if area < AREA_MIN or area > AREA_MAX:
                    continue

                x, y, w, h = cv2.boundingRect(cnt)
                if x <= 3 or y <= 3 or (x + w) >= (w_roi - 3) or (y + h) >= (h_roi - 3):
                    continue

                forma, info = clasificar_forma(cnt)
                cnt_global = cnt + np.array([rx1, ry1])
                gx, gy = x + rx1, y + ry1

                if forma:
                    figuras.append((area, forma, cnt_global))
                    color = COLORES[forma]
                    cv2.drawContours(frame, [cnt_global], -1, color, 2)
                    cv2.rectangle(frame, (gx, gy), (gx + w, gy + h), color, 2)
                    cv2.putText(frame, f"{forma} ({info})", (gx, max(20, gy - 8)),
                                cv2.FONT_HERSHEY_SIMPLEX, 0.55, color, 2)

            if esp32_ocupado:
                transcurrido = time.time() - t_envio
                estado_texto = f"CLASIFICANDO: {ultima_accion} ({transcurrido:.1f}s / 5.0s)"
                color_estado = (0, 165, 255)
            else:
                color_estado = (0, 255, 255)
                if figuras:
                    sin_figura = 0
                    _, forma, _ = max(figuras, key=lambda f: f[0])

                    if forma == ultima_forma:
                        estable += 1
                    else:
                        ultima_forma = forma
                        estable = 1

                    estado_texto = f"Detectando: {forma} ({estable}/{FRAMES_ESTABLES})"

                    if estable >= FRAMES_ESTABLES:
                        codigo = DESTINO[forma]
                        if enviar(ser, codigo):
                            esp32_ocupado = True
                            t_envio = time.time()
                            ultima_accion = f"{forma} -> {NOMBRE_DESTINO[codigo]}"
                            estado_texto = f"ENVIADO: {ultima_accion}"
                else:
                    sin_figura += 1
                    if sin_figura >= FRAMES_SIN_FIGURA:
                        ultima_forma = None
                        estable = 0
                    estado_texto = "LISTO: Esperando objeto en banda..."

            cv2.putText(frame, estado_texto, (10, 26),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.62, color_estado, 2)
            cv2.putText(frame, f"FPS: {fps:.0f} | {'ESP32 OK' if ser else 'SIN ESP32'}",
                        (10, 50), cv2.FONT_HERSHEY_SIMPLEX, 0.52,
                        (0, 255, 0) if ser else (0, 0, 255), 2)

            cv2.imshow("Clasificador Banda", frame)

            if mostrar_filtros:
                cv2.imshow("Mascara Umbral", mascara_umbral)
                cv2.imshow("Mascara Limpia", segmentada)

            tecla = cv2.waitKey(1) & 0xFF
            if tecla == ord("q"):
                break
            elif tecla == ord("m"):
                mostrar_filtros = not mostrar_filtros
                if not mostrar_filtros:
                    for v in ["Mascara Umbral", "Mascara Limpia"]:
                        cv2.destroyWindow(v)

    finally:
        cap.release()
        cv2.destroyAllWindows()
        if ser:
            ser.close()


if __name__ == "__main__":
    main()
